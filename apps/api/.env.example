APP_NAME=Kavo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kavo
DB_USERNAME=kavo_app
DB_PASSWORD=
DB_OWNER_USERNAME=kavo_owner
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:3000,127.0.0.1:8000,localhost:8000
FRONTEND_DASHBOARD_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174
FRONTEND_STOREFRONT_URL=http://localhost:3000

REVERB_APP_ID=kavo
REVERB_APP_KEY=kavo-local-key
REVERB_APP_SECRET=kavo-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

KAVO_ROOT_DOMAIN=kavo.test
KAVO_TLS_ASK_TOKEN=local-ask-token

BEON_BASE_URL=https://api.beon.chat
BEON_API_KEY=
BEON_WEBHOOK_SECRET=local-beon-secret

# Which gateway serves which rail. 'fake' keeps the whole lifecycle — including
# the offline one — drivable locally without credentials.
KAVO_CARD_GATEWAY=fake
KAVO_WALLET_GATEWAY=fake
KAVO_REFERENCE_GATEWAY=fake
KAVO_COD_GATEWAY=fake
KAVO_REFERENCE_EXPIRY_HOURS=72

PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=local-paymob-hmac-secret

# Staging host by default — point at atfawry.com only with live credentials.
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=local-fawry-security-key

SENTRY_LARAVEL_DSN=
# 0.1 in production, 1.0 in staging, 0 locally. Full tracing everywhere is
# expensive and noisy.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Git SHA, set by the deploy script. Tags errors and logs with the release
# that introduced them.
APP_RELEASE=

# Log any single query slower than this, with tenant and route context.
KAVO_SLOW_QUERY_MS=200
