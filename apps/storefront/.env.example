# Server-side only: the storefront reaches the API over the internal network
# during SSR, so this never reaches the browser.
NUXT_API_BASE=http://localhost:8000

# Must match the API's KAVO_INTERNAL_TOKEN. Lets one page render keep a
# single correlation id across the SSR hop instead of producing two
# unrelated sets of logs.
NUXT_INTERNAL_TOKEN=local-internal-token

NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_REVERB_KEY=kavo-local-key
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http

# Same Sentry project as the backend, tagged surface=storefront.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=local
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NUXT_PUBLIC_APP_RELEASE=

# Source map upload only runs when this is set, so credential-less builds
# still succeed.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
