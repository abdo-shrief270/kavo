VITE_API_BASE=http://localhost:8000

# Same Sentry project as the backend, tagged surface=dashboard. Leave empty
# locally — errors then stay in the console.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_RELEASE=

# Reverb. Without a key the dashboard falls back to HTTP only — alerts still
# arrive on load, just not instantly.
VITE_REVERB_KEY=kavo-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
